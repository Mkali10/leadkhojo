# LeadKhojo configuration. Copy to .env and adjust.
#
# Every variable the application reads is listed here, and a test fails the
# build if a setting is added without a line in this file. Nothing outside
# backend/src/leadkhojo/core/config.py reads the environment — that is also
# enforced by a test.
#
# Values shown are the defaults. Delete a line to keep the default.

# ---------------------------------------------------------------- application
LK_ENVIRONMENT=local
LK_DEBUG=false
LK_LOG_LEVEL=INFO
LK_LOG_JSON=true

# ---------------------------------------------------------------- server
#
#  ⚠️  v1 HAS NO AUTHENTICATION.
#
#  Do NOT bind to 0.0.0.0 or expose this instance to the internet. Anyone who
#  can reach it can run scans that appear to originate from your IP address —
#  which makes your address the one that gets blocked and your organisation the
#  one that receives the complaint.
#
#  Keep it on loopback, or put it behind a VPN or an authenticating proxy.
#  The server logs a warning at startup if it is bound publicly.
#
LK_HOST=127.0.0.1
LK_PORT=8000

# Browser origins allowed to call the API. Comma-separated. The Vite dev
# server by default; a deployment serving the built UI from the same origin
# needs none of these.
LK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- database
# docker-compose brings this up for you. Use `localhost` when running the API
# on the host, `db` when running it inside compose.
LK_DATABASE_URL=postgresql+asyncpg://leadkhojo:leadkhojo@localhost:5432/leadkhojo
LK_DB_POOL_SIZE=5
LK_DB_MAX_OVERFLOW=10
# Echoes every statement. Useful once, deafening thereafter.
LK_DB_ECHO=false

# ---------------------------------------------------------------- workers
# Background job execution. Jobs are claimed from the database, so raising
# the count raises database connections as well as concurrency.
LK_WORKER_COUNT=2
LK_WORKER_POLL_SECONDS=1.0
# A job still RUNNING after this long is assumed to belong to a dead worker
# and is returned to the queue. Must exceed the slowest realistic scan of one
# site, or healthy work gets duplicated.
LK_JOB_STALE_AFTER_SECONDS=900

# ---------------------------------------------------------------- crawler
# Politeness settings. Raising concurrency or lowering the delay makes our
# traffic look less like a visitor and more like an attack. Leave them alone
# unless you have a specific reason and have read docs/11-SECURITY-RULES.md.
#
# The User-Agent is honest and contactable on purpose. Do not put a browser
# string here: pretending to be Chrome is the difference between a crawler
# and an intruder.
LK_USER_AGENT=LeadKhojoBot/1.0 (+https://leadkhojo.com/bot)
LK_MAX_PAGES_PER_SITE=8
LK_REQUEST_TIMEOUT_SECONDS=15
LK_CONNECT_TIMEOUT_SECONDS=5
LK_SITE_BUDGET_SECONDS=60
LK_MAX_CONCURRENT_SITES=10
LK_HOST_DELAY_SECONDS=1.0
LK_MAX_REDIRECTS=5
LK_MAX_PAGE_BYTES=5242880

# Playwright fallback for JavaScript-rendered sites. Off by default: it costs
# roughly 20x an HTTP fetch and most business sites are server-rendered.
LK_ENABLE_PLAYWRIGHT=false
LK_RENDER_MIN_TEXT_CHARS=500

# ---------------------------------------------------------------- rules
# LK_RULES_DIR=/absolute/path/to/rules

# ---------------------------------------------------------------- plugins
# Comma-separated plugin ids to disable, e.g. "performance,cms". A plugin
# whose dependency is disabled is skipped rather than failing the boot.
LK_DISABLED_PLUGINS=

# ---------------------------------------------------------------- opportunities
#
#  AI REWRITING IS OFF BY DEFAULT AND MUST STAY THAT WAY UNLESS YOU MEAN IT.
#
#  A rewriter may ONLY rephrase text the rule engine already produced. It can
#  never create a finding, change urgency, or touch evidence — the interface
#  returns a string, so that is structurally impossible.
#
#  v1 ships NullRewriter and makes no model call at all.
#
LK_ENABLE_AI_REWRITE=false
# LK_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- discovery
LK_DISCOVERY_PROVIDER=csv_import
# LK_GOOGLE_PLACES_API_KEY=
# Google Places terms restrict how long provider fields may be cached.
LK_GOOGLE_PLACES_CACHE_DAYS=30

# ---------------------------------------------------------------- export
LK_EXPORT_DIR=./exports
# Ceiling on businesses per scan, and therefore rows per export or re-run.
# Raising it raises peak memory during PDF generation, which builds the whole
# document before writing a byte.
LK_MAX_BUSINESSES_PER_SCAN=500

# LeadKhojo configuration. Copy to .env and adjust.
# Every variable the application reads is listed here.

# ---------------------------------------------------------------- application
LK_ENVIRONMENT=local
LK_DEBUG=false
LK_LOG_LEVEL=INFO
LK_LOG_JSON=true

# ---------------------------------------------------------------- server
#
#  ⚠️  v1 HAS NO AUTHENTICATION.
#
#  Do NOT bind to 0.0.0.0 or expose this instance to the internet. Anyone who
#  can reach it can run scans that appear to originate from your IP address —
#  which makes your address the one that gets blocked and your organisation the
#  one that receives the complaint.
#
#  Keep it on loopback, or put it behind a VPN or an authenticating proxy.
#
LK_HOST=127.0.0.1
LK_PORT=8000

# ---------------------------------------------------------------- crawler
# Politeness settings. Raising concurrency or lowering the delay makes our
# traffic look less like a visitor and more like an attack. Leave them alone
# unless you have a specific reason and have read docs/11-SECURITY-RULES.md.
LK_USER_AGENT=LeadKhojoBot/1.0 (+https://leadkhojo.com/bot)
LK_MAX_PAGES_PER_SITE=8
LK_REQUEST_TIMEOUT_SECONDS=15
LK_CONNECT_TIMEOUT_SECONDS=5
LK_SITE_BUDGET_SECONDS=60
LK_MAX_CONCURRENT_SITES=10
LK_HOST_DELAY_SECONDS=1.0
LK_MAX_REDIRECTS=5

# Playwright fallback for JavaScript-rendered sites. Off by default: it costs
# roughly 20x an HTTP fetch and most business sites are server-rendered.
LK_ENABLE_PLAYWRIGHT=false
LK_RENDER_MIN_TEXT_CHARS=500

# ---------------------------------------------------------------- rules
# LK_RULES_DIR=/absolute/path/to/rules

# ---------------------------------------------------------------- plugins
# Comma-separated plugin ids to disable, e.g. "performance,cms"
# LK_DISABLED_PLUGINS=

# ---------------------------------------------------------------- opportunities
#
#  AI REWRITING IS OFF BY DEFAULT AND MUST STAY THAT WAY UNLESS YOU MEAN IT.
#
#  A rewriter may ONLY rephrase text the rule engine already produced. It can
#  never create a finding, change urgency, or touch evidence — the interface
#  returns a string, so that is structurally impossible.
#
#  v1 ships NullRewriter and makes no model call at all.
#
LK_ENABLE_AI_REWRITE=false
# LK_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- discovery
LK_DISCOVERY_PROVIDER=csv_import
# LK_GOOGLE_PLACES_API_KEY=
# Google Places terms restrict how long provider fields may be cached.
LK_GOOGLE_PLACES_CACHE_DAYS=30

# ---------------------------------------------------------------- database
# Not required for CLI scans. Needed once the API and persistence land.
LK_DATABASE_URL=postgresql+asyncpg://leadkhojo:leadkhojo@localhost:5432/leadkhojo
